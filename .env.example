# Salin ke .env.local lalu isi. Role dan database dibuat sekali lewat db/siapkan.sql (lihat README, bagian Basis data).
# Port 5432 untuk Postgres sistem, 5544 untuk klaster pribadi di .pgdata.
DATABASE_URL=postgres://weton_city:GANTI@127.0.0.1:5432/weton_city
DATABASE_URL_UJI=postgres://weton_city:GANTI@127.0.0.1:5432/weton_city_test
# Opsional: bila diisi, pendaftaran wajib memakai kode ini (untuk fase warga undangan).
# KODE_UNDANGAN=
# Opsional: pengingat web push. Buat dengan `pnpm push:kunci`. PUSH_RAHASIA dipakai cron luar untuk POST /api/push/kirim.
# VAPID_PUBLIK=
# VAPID_RAHASIA=
# VAPID_SUBJEK=mailto:alamat-kamu@contoh.com
# PUSH_RAHASIA=
